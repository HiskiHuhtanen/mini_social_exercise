{% extends "base.html.j2" %}

{% block content %}
<div class="container my-5">
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary ">
            <h2 class="h4 mb-0">My Groups</h2>
        </div>

        <div class="card-body">
            {% for group in users_groups %}
                <div class="mb-3">
                    <strong>{{ group.name }}</strong>
                    <p class="text-muted mb-0"> {{ group.description }} </p>
                    <form action="{{ url_for('group_feed', group_id=group.id) }}" method="POST" class="d-inline">
                     <button type="submit" class="btn btn-primary">Go to Group</button>
                    </form>
                </div>
            {% else %}
                <p class="text-muted">
                    You haven't joined any groups
                </p>
            {% endfor %}
        </div>
    </div>
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary ">
            <h2 class="h4 mb-0">All Groups</h2>
        </div>

        <div class="card-body"
             style="max-height: 500px; overflow-y: auto;">

            {% for group in other_groups %}
                <div class="mb-3">
                    <strong>{{ group.name }}</strong>
                    <p class="text-muted mb-0"> {{ group.description }}</p>
                    <form action="{{ url_for('group_feed', group_id=group.id) }}" method="POST" class="d-inline">
                     <button type="submit" class="btn btn-primary">Go to Group</button>
                    </form>
                </div>
            {% else %}
                <p class="text-muted">
                    No other groups available
                </p>
            {% endfor %}

        </div>
    </div>

    <a href="/group_creation" class="btn btn-primary">
        Create a Group
    </a>

</div>
{% endblock %}