{% extends "base.html.j2" %}

{% block content %}
<div class="container my-5">
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary ">
            <h2 class="h4 mb-0">Chat with {{ other_user.username }}</h2>
        </div>
    </div>

    <div class="card-body" style="max-height: 500px; overflow-y: auto;">
        {% for message in messages %}
            <div class="mb-3">
                <strong>{{ message.username }}</strong>
                <small class="text-muted">{{ message.created_at }}</small>
                <p class="mb-0">{{ message.content }}</p>
            </div>
        {% else %}
            <p class="text-muted">No messages</p>
        {% endfor %}
        </div>
    </div>   

    <form method="POST">
        <div class="mb-3">
            <textarea class="form-control" name="content" rows="2" placeholder="Send message:" required></textarea>
        </div>
        <button type="submit" class="btn btn-primary float-end">Send</button>
    </form>
</div>


{% endblock %}
